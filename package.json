{
  "name": "trainsection",
  "private": true,
  "version": "1.0.0",
  "description": "Rutina de gimnasio, registro de entrenos, check-ins con fotos y menús baratos. PWA para Android e iPhone y APK para Android.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "icons": "node scripts/icons.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "android:sync": "vite build --mode native && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "jsqr": "^1.4.0",
    "lz-string": "^1.5.0",
    "preact": "^10.29.8",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@preact/preset-vite": "^2.10.6",
    "sharp": "^0.35.5",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
